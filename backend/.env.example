DATABASE_URL=postgresql+asyncpg://cr_user:cr_pass@localhost:5432/clash_royale
# Docker Compose overrides DATABASE_URL to use host "db" inside containers.
CLASH_ROYALE_API_KEY=your_api_key_here
CLASH_ROYALE_API_BASE_URL=https://api.clashroyale.com/v1
ADMIN_API_KEY=change_me_admin_key
SYNC_ON_STARTUP=false
CARD_SYNC_CRON_HOUR=3
LEADERBOARD_TOP_N=100
LEADERBOARD_PAGE_LIMIT=100
UNTRACK_AFTER_MISSES=3
BATTLES_PER_PLAYER=25
OPPONENT_EXPANSION_ROUNDS=2
SYNC_RANKED_BATTLES_ONLY=true
BATTLELOG_BATCH_SIZE=10
OPERATION_LOG_DIR=logs
OPERATION_PROGRESS_EVERY_N=10
OPERATION_PROGRESS_INTERVAL_SECONDS=30
